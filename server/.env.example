# Copy to server/.env (never commit .env) and replace every CHANGE_ME with your own local passwords.
# Only local databases are accepted: the server and every db:* script refuse other hosts or database names.

# --- docker compose (PostgreSQL 17 container) ---
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_superuser_password
NBLAO_APP_PASSWORD=CHANGE_ME_app_password
POSTGRES_PORT=5432

# --- API server and Prisma (role nblao_app; use the same password as NBLAO_APP_PASSWORD) ---
NODE_ENV=development
DATABASE_URL=postgresql://nblao_app:CHANGE_ME_app_password@127.0.0.1:5432/nblao_dev
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info

# --- authentication (Phase 1E, local development only) ---
# AES-256-GCM key for 2FA secrets: 32 random bytes, base64. Do not type one by hand: run `pnpm auth:setup-keys`,
# which adds a random key to server/.env. Replacing the key later invalidates every 2FA enrolment.
TOTP_ENCRYPTION_KEY=
# Browser origins allowed to send sign-in and admin requests (exact loopback origins, comma-separated).
# Default: http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:8443,http://localhost:8443
# ALLOWED_ORIGINS=
# Secure cookies need HTTPS; plain-http loopback development keeps this false.
COOKIE_SECURE=false

# --- database integration tests (pnpm test:db) ---
TEST_DATABASE_URL=postgresql://nblao_app:CHANGE_ME_app_password@127.0.0.1:5432/nblao_test
