// Catalog-only schema (Phase 1B A6). Mirrors the frontend catalog types in src/data.ts (Product),
// src/brands.ts (Brand) and src/lib/variants.ts (ProductOption, ProductVariant).
// Money is stored as integer minor units (BigInt) plus an ISO 4217 currency code, like src/commerce/money.ts.
// Stock/inventory, orders, RFQs and users are intentionally not modelled yet.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  // Stable text key, same as the frontend brand id (e.g. "brand-siemens").
  id           String    @id
  name         String
  nameLo       String?   @map("name_lo")
  logoUrl      String?   @map("logo_url")
  websiteUrl   String?   @map("website_url")
  description  String?
  active       Boolean   @default(true)
  displayOrder Int       @default(0) @map("display_order")
  isDemo       Boolean   @default(false) @map("is_demo")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  products     Product[]

  @@map("brands")
}

model Category {
  id           String     @id @default(uuid()) @db.Uuid
  // URL-safe unique key, e.g. "electrical-equipment" or "electrical-equipment/transformers".
  slug         String     @unique
  name         String
  parentId     String?    @map("parent_id") @db.Uuid
  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[] @relation("CategoryTree")
  displayOrder Int        @default(0) @map("display_order")
  isDemo       Boolean    @default(false) @map("is_demo")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  products     Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  // Numeric id used by the current frontend (kept for later migration of stored carts/RFQs).
  legacyId         Int?             @unique @map("legacy_id")
  sku              String           @unique
  name             String
  model            String?
  brandId          String?          @map("brand_id")
  brand            Brand?           @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categoryId       String           @map("category_id") @db.Uuid
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // Integer minor units of `currency` (e.g. USD cents). Non-negative (CHECK constraint in the migration).
  priceMinor       BigInt           @map("price_minor")
  currency         String           @db.Char(3)
  priceUnit        String?          @map("price_unit")
  minOrderQuantity Int?             @map("min_order_quantity")
  leadTime         String?          @map("lead_time")
  shortDescription String?          @map("short_description")
  description      String?
  // [{ label, value }] in display order.
  specs            Json             @default("[]")
  // [{ name, values: string[] }] in display order (src/lib/variants.ts ProductOption).
  options          Json             @default("[]")
  applications     String[]         @default([])
  tags             String[]         @default([])
  certifications   String[]         @default([])
  featured         Boolean          @default(false)
  active           Boolean          @default(true)
  // Options/variants are demonstration defaults, not manufacturer-verified (frontend demoOptions).
  demoOptions      Boolean          @default(false) @map("demo_options")
  isDemo           Boolean          @default(false) @map("is_demo")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  variants         ProductVariant[]
  images           ProductImage[]

  @@index([brandId])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id           String         @id @default(uuid()) @db.Uuid
  productId    String         @map("product_id") @db.Uuid
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku          String         @unique
  // { optionName: value } (src/lib/variants.ts ProductVariant.options).
  optionValues Json           @map("option_values")
  // Null means the variant inherits the product price. Same currency as the product.
  priceMinor   BigInt?        @map("price_minor")
  active       Boolean        @default(true)
  visible      Boolean        @default(true)
  purchasable  Boolean        @default(true)
  isDemo       Boolean        @default(false) @map("is_demo")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  images       ProductImage[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String          @id @default(uuid()) @db.Uuid
  productId String          @map("product_id") @db.Uuid
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Null for product-level images; set for images that belong to one variant.
  variantId String?         @map("variant_id") @db.Uuid
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  url       String
  altText   String?         @map("alt_text")
  position  Int             @default(0)
  isDemo    Boolean         @default(false) @map("is_demo")
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([productId, position])
  @@index([variantId])
  @@map("product_images")
}

// ─── Phase 1E: authentication, authorization and 2FA ─────────────────────────────────────────────────────────
// Passwords are Argon2id PHC strings; session, reset and invitation tokens are stored only as SHA-256 hashes;
// TOTP secrets are AES-256-GCM encrypted. Audit events are append-only (database trigger in the migration).

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES
  WAREHOUSE
}

enum StaffStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum CustomerStatus {
  INVITED
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum SubjectType {
  STAFF
  CUSTOMER
}

enum SessionStage {
  PASSWORD_CHANGE_REQUIRED
  MFA_ENROLLMENT_REQUIRED
  MFA_REQUIRED
  FULL
}

enum TokenPurpose {
  PASSWORD_RESET
  INVITATION
}

enum AuditCategory {
  SECURITY
  OPERATIONAL
}

enum InvitationRequestStatus {
  PENDING
  ISSUED
  DECLINED
}

model Team {
  id                 String                      @id @default(uuid()) @db.Uuid
  name               String                      @unique
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  staff              StaffUser[]
  customers          Customer[]
  invitationRequests CustomerInvitationRequest[]

  @@map("teams")
}

/// A Manager's request for a customer invitation. Filing it never reads the customers table (no enumeration across
/// Manager scopes); an Admin or Super Admin issues the invitation (creating the INVITED customer) or declines.
model CustomerInvitationRequest {
  id              String                  @id @default(uuid()) @db.Uuid
  // Lowercase (CHECK constraint). Deliberately not unique.
  email           String
  firstName       String                  @map("first_name")
  lastName        String                  @map("last_name")
  phone           String
  companyName     String                  @map("company_name")
  teamId          String?                 @map("team_id") @db.Uuid
  team            Team?                   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedStaffId String?                 @map("assigned_staff_id") @db.Uuid
  assignedStaff   StaffUser?              @relation("InvitationRequestAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  // Separation of duties: the requester can never approve or reject the resulting customer.
  requestedById   String                  @map("requested_by_id") @db.Uuid
  status          InvitationRequestStatus @default(PENDING)
  decidedById     String?                 @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?               @map("decided_at")
  // Internal note, shown to Admin and Super Admin only.
  decisionNote    String?                 @map("decision_note")
  customerId      String?                 @unique @map("customer_id") @db.Uuid
  customer        Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([requestedById])
  @@map("customer_invitation_requests")
}

model StaffUser {
  id                 String            @id @default(uuid()) @db.Uuid
  // Lowercase (CHECK constraint); a separate namespace from customer emails.
  email              String            @unique
  displayName        String            @map("display_name")
  role               StaffRole
  status             StaffStatus       @default(ACTIVE)
  teamId             String?           @map("team_id") @db.Uuid
  team               Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  // Null until the account is set up through its one-time setup link (or created by the CLI).
  passwordHash       String?           @map("password_hash")
  mustChangePassword Boolean           @default(false) @map("must_change_password")
  passwordChangedAt  DateTime?         @map("password_changed_at")
  failedLoginCount   Int               @default(0) @map("failed_login_count")
  lockedUntil        DateTime?         @map("locked_until")
  lastLoginAt        DateTime?         @map("last_login_at")
  // Two-factor failures are counted separately from password failures. This account-wide counter is for monitoring
  // only (audited alert); it never blocks anything, so nobody can lock a colleague's 2FA. Blocking is per sign-in
  // challenge (session) and per account + source address (MfaThrottle).
  mfaFailedCount     Int               @default(0) @map("mfa_failed_count")
  // Not used since the per-source throttle replaced the account-wide lock (kept: dropping a column needs approval).
  mfaLockedUntil     DateTime?         @map("mfa_locked_until")
  createdById        String?           @map("created_by_id") @db.Uuid
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  mfa                StaffMfa?
  recoveryCodes      MfaRecoveryCode[]
  sessions           Session[]
  tokens             AccountToken[]
  mfaThrottles       MfaThrottle[]
  assignedCustomers  Customer[]        @relation("CustomerAssignee")
  invitationRequests CustomerInvitationRequest[] @relation("InvitationRequestAssignee")

  @@index([teamId])
  @@index([role, status])
  @@map("staff_users")
}

/// 2FA failure throttle per staff account and source address. Wrong codes from one source can only block that
/// source for that account; other sources and existing sessions of the account are unaffected.
model MfaThrottle {
  id           String    @id @default(uuid()) @db.Uuid
  staffId      String    @map("staff_id") @db.Uuid
  staff        StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  // SHA-256 of the source address with a fixed label: no plain IP addresses are stored.
  sourceHash   Bytes     @map("source_hash")
  failedCount  Int       @default(0) @map("failed_count")
  windowStart  DateTime  @map("window_start")
  blockCount   Int       @default(0) @map("block_count")
  blockedUntil DateTime? @map("blocked_until")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([staffId, sourceHash])
  @@map("mfa_throttles")
}

model StaffMfa {
  staffId                 String    @id @map("staff_id") @db.Uuid
  staff                   StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  // AES-256-GCM: iv (12 bytes) + tag (16 bytes) + ciphertext. Never returned after enrolment.
  secretCiphertext        Bytes     @map("secret_ciphertext")
  // Null while enrolment has started but is not confirmed yet.
  enabledAt               DateTime? @map("enabled_at")
  // Last accepted TOTP time step (replay protection).
  lastUsedStep            BigInt?   @map("last_used_step")
  // Re-enrolment of an already enabled authenticator: the new secret waits here (encrypted) until a code from
  // the new device confirms it, so the old device keeps working and 2FA is never switched off in between.
  pendingSecretCiphertext Bytes?    @map("pending_secret_ciphertext")
  pendingCreatedAt        DateTime? @map("pending_created_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@map("staff_mfa")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  staffId   String    @map("staff_id") @db.Uuid
  staff     StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  codeHash  Bytes     @unique @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([staffId])
  @@map("mfa_recovery_codes")
}

model Customer {
  id                String         @id @default(uuid()) @db.Uuid
  email             String         @unique
  firstName         String         @map("first_name")
  lastName          String         @map("last_name")
  phone             String
  // Free text until a Company entity exists (Phase 1F).
  companyName       String         @map("company_name")
  status            CustomerStatus @default(PENDING)
  statusReason      String?        @map("status_reason")
  teamId            String?        @map("team_id") @db.Uuid
  team              Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedStaffId   String?        @map("assigned_staff_id") @db.Uuid
  assignedStaff     StaffUser?     @relation("CustomerAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  // Null only while INVITED (CHECK constraint).
  passwordHash      String?        @map("password_hash")
  failedLoginCount  Int            @default(0) @map("failed_login_count")
  lockedUntil       DateTime?      @map("locked_until")
  lastLoginAt       DateTime?      @map("last_login_at")
  // Separation of duties: the inviter can never be the approver (CHECK constraint + server rule).
  invitedById       String?        @map("invited_by_id") @db.Uuid
  approvedById      String?        @map("approved_by_id") @db.Uuid
  approvedAt        DateTime?      @map("approved_at")
  statusChangedById String?        @map("status_changed_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  sessions          Session[]
  tokens            AccountToken[]
  invitationRequest CustomerInvitationRequest?

  @@index([status])
  @@index([teamId])
  @@index([assignedStaffId])
  @@map("customers")
}

model Session {
  id                String       @id @default(uuid()) @db.Uuid
  // SHA-256 of the cookie token. The CSRF token is derived from the cookie token (HMAC), so it is not stored.
  tokenHash         Bytes        @unique @map("token_hash")
  subjectType       SubjectType  @map("subject_type")
  staffId           String?      @map("staff_id") @db.Uuid
  staff             StaffUser?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customerId        String?      @map("customer_id") @db.Uuid
  customer          Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  stage             SessionStage @default(FULL)
  mfaVerifiedAt     DateTime?    @map("mfa_verified_at")
  mfaFailedAttempts Int          @default(0) @map("mfa_failed_attempts")
  rememberMe        Boolean      @default(false) @map("remember_me")
  createdAt         DateTime     @default(now()) @map("created_at")
  lastSeenAt        DateTime     @map("last_seen_at")
  idleExpiresAt     DateTime     @map("idle_expires_at")
  absoluteExpiresAt DateTime     @map("absolute_expires_at")
  revokedAt         DateTime?    @map("revoked_at")
  revokedReason     String?      @map("revoked_reason")
  userAgent         String?      @map("user_agent")

  @@index([staffId])
  @@index([customerId])
  @@index([absoluteExpiresAt])
  @@map("sessions")
}

model AccountToken {
  id          String       @id @default(uuid()) @db.Uuid
  tokenHash   Bytes        @unique @map("token_hash")
  purpose     TokenPurpose
  subjectType SubjectType  @map("subject_type")
  staffId     String?      @map("staff_id") @db.Uuid
  staff       StaffUser?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  customerId  String?      @map("customer_id") @db.Uuid
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  issuedById  String?      @map("issued_by_id") @db.Uuid
  expiresAt   DateTime     @map("expires_at")
  usedAt      DateTime?    @map("used_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([staffId])
  @@index([customerId])
  @@map("account_tokens")
}

model AuditEvent {
  id          String        @id @default(uuid()) @db.Uuid
  at          DateTime      @default(now())
  category    AuditCategory
  type        String
  outcome     String
  actorType   SubjectType?  @map("actor_type")
  actorId     String?       @map("actor_id") @db.Uuid
  subjectType SubjectType?  @map("subject_type")
  subjectId   String?       @map("subject_id") @db.Uuid
  // Copied at write time so Manager read access can be scoped by team.
  teamId      String?       @map("team_id") @db.Uuid
  // Never passwords, tokens, codes, hashes or full IP addresses.
  details     Json          @default("{}")

  @@index([category, at])
  @@index([teamId, at])
  @@index([subjectId])
  @@map("audit_events")
}
