{
  "name": "@nblao/server",
  "version": "0.0.0",
  "private": true,
  "description": "NB LAO shop API (local development only; not deployed).",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/db.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/db.ts seed",
    "db:reset": "node --env-file-if-exists=.env --import tsx scripts/db.ts reset"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
