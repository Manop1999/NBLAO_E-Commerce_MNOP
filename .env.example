# Frontend build settings. Copy to .env.local for local development (never commit .env.local).
# Only public, non-secret values belong here: everything VITE_* is compiled into the browser bundle.

# Catalog source for the storefront:
#   demo  (default) bundled demo catalog — the only value allowed for GitHub Pages builds
#   api   local Fastify catalog API at 127.0.0.1:3001 through the Vite dev proxy (local development only;
#         the dev server then listens on 127.0.0.1). scripts/verify-build-output.mjs refuses api builds.
VITE_CATALOG_SOURCE=demo
